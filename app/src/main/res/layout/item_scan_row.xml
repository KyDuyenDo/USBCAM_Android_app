<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/row_scan_item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="44dp"
        android:orientation="horizontal"
        android:paddingVertical="6dp"
        android:paddingHorizontal="4dp">

        <TextView android:id="@+id/tv_row_ry"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="2" android:textSize="10sp"
            android:textColor="#1A202C" android:gravity="center"
            android:textStyle="bold"/>

        <TextView android:id="@+id/tv_row_art"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1.2" android:textSize="10sp"
            android:textColor="#1A202C" android:gravity="center"/>

        <TextView android:id="@+id/tv_row_model"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="2" android:textSize="9sp"
            android:textColor="#4A5568" android:gravity="center"
            android:maxLines="2"/>

        <TextView android:id="@+id/tv_row_order"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1.2" android:textSize="11sp"
            android:textColor="#1A202C" android:gravity="center"/>

        <TextView android:id="@+id/tv_row_scan"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1.2" android:textSize="11sp"
            android:textColor="#1A202C" android:gravity="center"
            android:textStyle="bold"/>

        <TextView android:id="@+id/tv_row_erp"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:textSize="11sp"
            android:textColor="#1A202C" android:gravity="center"/>

        <TextView android:id="@+id/tv_row_adjust"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:textSize="11sp"
            android:textColor="#1A202C" android:gravity="center"/>

        <TextView android:id="@+id/tv_row_remaining"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1.5" android:textSize="12sp"
            android:textColor="#F44336" android:gravity="center"
            android:textStyle="bold"/>

        <TextView android:id="@+id/tv_row_dateid"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1.5" android:textSize="10sp"
            android:textColor="#1A202C" android:gravity="center"/>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E4E8"/>
</LinearLayout>
