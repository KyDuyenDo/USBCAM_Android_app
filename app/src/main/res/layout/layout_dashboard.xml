<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main">

    <!-- Dashboard UI -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp"
        android:animateLayoutChanges="true">

        <TextView
            android:id="@+id/tv_no_internet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/error_red"
            android:gravity="center"
            android:padding="8dp"
            android:text="Mất kết nối Internet"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            android:elevation="4dp"/>

        <TextView
            android:id="@+id/tv_camera_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/orange_warning"
            android:gravity="center"
            android:padding="8dp"
            android:text="USB Camera signal not detected"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/tv_no_internet"
            android:elevation="4dp"/>

        <!-- Top Section: Stats and Table -->
        <LinearLayout
            android:id="@+id/ll_top"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:orientation="horizontal"
            android:baselineAligned="false"
            app:layout_constraintTop_toBottomOf="@id/tv_no_internet"
            app:layout_constraintHeight_percent="0.55"
            android:layout_marginBottom="16dp">

            <!-- Card 1: Production Schedule -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:layout_marginEnd="8dp">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@color/primary_blue"
                    android:padding="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="STT"
                        android:textColor="@color/white"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="3"
                        android:gravity="center"
                        android:text="Khung giờ"
                        android:textColor="@color/white"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:gravity="center"
                        android:text="Mục tiêu"
                        android:textColor="@color/white"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:gravity="center"
                        android:text="Sản lượng"
                        android:textColor="@color/white"
                        android:textStyle="bold" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerTimeSlot"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:paddingBottom="8dp"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/border_color" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_table_footer"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tổng :"
                        android:textColor="@color/text_primary"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_total_target"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="160"
                        android:textColor="@color/text_primary"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_total_actual"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="6"
                        android:textColor="@color/error_red"
                        android:textSize="24sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>

            <!-- Card 2: Camera Feed -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:layout_marginStart="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                     <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Live Camera Feed"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                    
                        android:paddingVertical="4dp"/>
                    <TextView
                        android:id="@+id/tv_live_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LIVE"
                        android:background="@drawable/bg_status_badge"
                        android:backgroundTint="@color/error_red"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp"/>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/sw_camera"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:checked="true"
                        app:useMaterialThemeColors="true"/>
                </LinearLayout>
                
                <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/border_color" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="16dp">

                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        app:layout_constraintDimensionRatio="4:3"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="@color/black">

                        <com.jiangdg.ausbc.widget.AspectRatioTextureView
                            android:id="@+id/tvCameraRender"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_gravity="center"/>
                    </androidx.cardview.widget.CardView>

                    <TextView
                        android:id="@+id/tv_status_ok"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:layout_marginTop="24dp"
                        android:background="@drawable/bg_status_badge"
                        android:backgroundTint="@color/success_green"
                        android:paddingHorizontal="24dp"
                        android:paddingVertical="8dp"
                        android:text="OK"
                        android:textColor="@color/white"
                        android:textSize="32sp"
                        android:textStyle="bold"
                        android:elevation="4dp"
                        tools:text="SUCCESS"/>

                    <TextView
                        android:id="@+id/tv_countdown"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_status_badge"
                        android:backgroundTint="#80000000"
                        android:paddingHorizontal="40dp"
                        android:paddingVertical="20dp"
                        android:text="5"
                        android:textColor="@color/white"
                        android:textSize="120sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        android:elevation="10dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:visibility="visible" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>
        </LinearLayout>


        <!-- Middle Section: 4 Equal Columns -->
        <LinearLayout
            android:id="@+id/ll_middle"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:orientation="horizontal"
            android:baselineAligned="false"
            app:layout_constraintTop_toBottomOf="@id/ll_top"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginTop="16dp">

            <!-- Column 1: Product Info -->
            <LinearLayout
                android:id="@+id/card_product_info"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:layout_marginEnd="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Product Details"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp"/>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/border_color"
                        android:layout_marginBottom="8dp"/>

                    <!-- Info Rows -->
                    <LinearLayout
                        style="@style/InfoRow">
                        <TextView style="@style/InfoLabel" android:text="Country:" />
                        <TextView android:id="@+id/tv_country" style="@style/InfoValue" android:text="GERMANY" />
                    </LinearLayout>

                    <LinearLayout style="@style/InfoRow">
                        <TextView style="@style/InfoLabel" android:text="Art:" />
                        <TextView android:id="@+id/tv_art" style="@style/InfoValue" android:text="JH9767" />
                    </LinearLayout>

                    <LinearLayout style="@style/InfoRow">
                        <TextView style="@style/InfoLabel" android:text="Total Order:" />
                        <TextView android:id="@+id/tv_total_order" style="@style/InfoValue" android:text="300" />
                    </LinearLayout>

                    <LinearLayout style="@style/InfoRow">
                        <TextView style="@style/InfoLabel" android:text="Completed:" />
                        <TextView android:id="@+id/tv_completed" style="@style/InfoValue" android:text="0" />
                    </LinearLayout>

                    <LinearLayout style="@style/InfoRow">
                        <TextView style="@style/InfoLabel" android:text="Remaining:" />
                        <TextView android:id="@+id/tv_remaining" style="@style/InfoValue" android:text="300" android:textColor="@color/error_red" />
                    </LinearLayout>

                    <LinearLayout style="@style/InfoRow">
                        <TextView style="@style/InfoLabel" android:text="Lean:" />
                        <TextView android:id="@+id/tv_lean" style="@style/InfoValue" android:text="A1_G01" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Column 2: Product Image -->
            <LinearLayout
                android:id="@+id/card_product_image"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="12dp"
                android:layout_marginEnd="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Product Image"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp">
                    <ImageView
                        android:id="@+id/iv_shoe_image"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerInside"
                        android:src="@android:drawable/ic_menu_report_image"
                        tools:srcCompat="@drawable/shoe_placeholder" />
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- Column 3: Stats -->
            <LinearLayout
                android:id="@+id/card_stats"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="12dp"
                android:layout_marginEnd="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Order Stats"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/border_color"
                    android:layout_marginBottom="8dp"/>

                <LinearLayout style="@style/InfoRow">
                    <TextView style="@style/InfoLabel" android:text="RY:" />
                    <TextView android:id="@+id/tv_ry_value" style="@style/InfoValue" android:text="AH2412-751" />
                </LinearLayout>

                <LinearLayout style="@style/InfoRow">
                    <TextView style="@style/InfoLabel" android:text="Size:" />
                    <TextView android:id="@+id/tv_size_value" style="@style/InfoValue" android:text="08" />
                </LinearLayout>

                <LinearLayout style="@style/InfoRow">
                    <TextView style="@style/InfoLabel" android:text="Qty:" />
                    <TextView android:id="@+id/tv_qty_value" style="@style/InfoValue" android:text="12" />
                </LinearLayout>

                <LinearLayout style="@style/InfoRow">
                    <TextView style="@style/InfoLabel" android:text="PO No:" />
                    <TextView android:id="@+id/tv_po_value" style="@style/InfoValue" android:text="0900005032" android:ellipsize="end" android:maxLines="1"/>
                </LinearLayout>

                <LinearLayout style="@style/InfoRow">
                    <TextView style="@style/InfoLabel" android:text="UPC:" />
                    <TextView android:id="@+id/tv_upc_value" style="@style/InfoValue" android:text="4067898529187" android:ellipsize="end" android:maxLines="1" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_scan_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Last Scan: --"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <ProgressBar
                    android:id="@+id/pbMotion"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- Column 4: RFID Display Area -->
            <LinearLayout
                android:id="@+id/card_rfid"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_card"
                android:orientation="vertical">

                <!-- Header with Settings Icon -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="12dp"
                    android:paddingBottom="8dp">

                    <ImageView
                        android:id="@+id/iv_rfid_icon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_rfid_card"
                        app:tint="@color/primary_blue"
                        android:layout_marginEnd="8dp"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="RFID Scanner"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"/>

                    <!-- Settings Icon Button -->
                    <ImageView
                        android:id="@+id/btn_usb_rfid"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@android:drawable/ic_menu_manage"
                        app:tint="@color/primary_blue"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:padding="4dp"/>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/border_color"
                    android:layout_marginBottom="8dp"/>

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fillViewport="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <!-- Product Information from API -->
                        <LinearLayout
                            android:id="@+id/ll_rfid_product_info"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <!-- Model -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginBottom="6dp">
                                <TextView
                                    android:layout_width="60dp"
                                    android:layout_height="wrap_content"
                                    android:text="Model:"
                                    android:textSize="11sp"
                                    android:textColor="@color/text_secondary"/>
                                <TextView
                                    android:id="@+id/tv_rfid_model"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="---"
                                    android:textSize="11sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/text_primary"/>
                            </LinearLayout>

                            <!-- Article -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginBottom="6dp">
                                <TextView
                                    android:layout_width="60dp"
                                    android:layout_height="wrap_content"
                                    android:text="Article:"
                                    android:textSize="11sp"
                                    android:textColor="@color/text_secondary"/>
                                <TextView
                                    android:id="@+id/tv_rfid_article"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="---"
                                    android:textSize="11sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/text_primary"/>
                            </LinearLayout>

                            <!-- PO -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginBottom="6dp">
                                <TextView
                                    android:layout_width="60dp"
                                    android:layout_height="wrap_content"
                                    android:text="PO:"
                                    android:textSize="11sp"
                                    android:textColor="@color/text_secondary"/>
                                <TextView
                                    android:id="@+id/tv_rfid_po"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="---"
                                    android:textSize="11sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/text_primary"/>
                            </LinearLayout>

                            <!-- Color -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginBottom="6dp">
                                <TextView
                                    android:layout_width="60dp"
                                    android:layout_height="wrap_content"
                                    android:text="Color:"
                                    android:textSize="11sp"
                                    android:textColor="@color/text_secondary"/>
                                <TextView
                                    android:id="@+id/tv_rfid_color"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="---"
                                    android:textSize="11sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/text_primary"/>
                            </LinearLayout>

                            <!-- Size -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">
                                <TextView
                                    android:layout_width="60dp"
                                    android:layout_height="wrap_content"
                                    android:text="Size:"
                                    android:textSize="11sp"
                                    android:textColor="@color/text_secondary"/>
                                <TextView
                                    android:id="@+id/tv_rfid_size"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="---"
                                    android:textSize="11sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/text_primary"/>
                            </LinearLayout>

                            <!-- Connection Status -->
                            <TextView
                                android:id="@+id/tv_rfid_status"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="• Not Connected"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp"
                                android:layout_marginBottom="12dp"/>

                        </LinearLayout>

                        <!-- Last EPC -->
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp">

                            <TextView
                                android:id="@+id/tv_epc_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="EPC CODE"
                                android:textColor="@color/text_secondary"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent"/>

                            <TextView
                                android:id="@+id/tv_dashboard_last_rfid"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="---"
                                android:textColor="@color/primary_blue"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:fontFamily="monospace"
                                app:layout_constraintStart_toEndOf="@id/tv_epc_label"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="@id/tv_epc_label"
                                app:layout_constraintBottom_toBottomOf="@id/tv_epc_label"/>

                        </androidx.constraintlayout.widget.ConstraintLayout>

                    </LinearLayout>
                </ScrollView>

            </LinearLayout>

        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
