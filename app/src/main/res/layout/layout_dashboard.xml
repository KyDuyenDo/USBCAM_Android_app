<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main">

    <!-- Dashboard UI -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:animateLayoutChanges="true"
        android:padding="16dp">

        <TextView
            android:id="@+id/tv_no_internet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/error_red"
            android:elevation="4dp"
            android:gravity="center"
            android:padding="8dp"
            android:text="Mất kết nối Internet"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent" />



        <!-- Top Section: Stats and Table -->
        <LinearLayout
            android:id="@+id/ll_top"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="16dp"
            android:baselineAligned="false"
            android:orientation="horizontal"
            app:layout_constraintHeight_percent="0.55"
            app:layout_constraintTop_toBottomOf="@id/tv_no_internet">

            <!-- Card 1: Production Schedule -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card"
                android:orientation="vertical">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/primary_blue"
                    android:orientation="horizontal"
                    android:padding="5dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="STT"
                        android:textSize="20sp"
                        android:textColor="@color/white"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="3"
                        android:gravity="center"
                        android:text="Khung giờ"
                        android:textColor="@color/white"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:gravity="center"
                        android:text="Mục tiêu"
                        android:textColor="@color/white"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:gravity="center"
                        android:text="Sản lượng"
                        android:textSize="20sp"
                        android:textColor="@color/white"
                        android:textStyle="bold" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerTimeSlot"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:paddingBottom="8dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/border_color" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_table_footer"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tổng :"
                        android:textColor="@color/text_primary"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_total_target"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="160"
                        android:textColor="@color/text_primary"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_total_actual"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="6"
                        android:textColor="@color/error_red"
                        android:textSize="24sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>

            <!-- Card 2: Camera Feed -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="1dp">

                    <!-- Line Selector (Left) -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Line:"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginStart="14dp"
                        android:layout_marginEnd="4dp" />

                    <Spinner
                        android:id="@+id/spinner_line"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:minWidth="90dp"
                        android:background="@drawable/bg_status_badge"
                        android:backgroundTint="@color/primary_blue"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:popupBackground="@color/bg_main"
                        android:spinnerMode="dropdown" />

                    <!-- Live Text (Middle - taking space) -->
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text=""
                        android:textColor="@color/text_primary"
                        android:paddingLeft="10dp"
                        android:textSize="18dp"
                        android:textStyle="bold" />


                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/border_color" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="16dp">

                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        app:cardBackgroundColor="@color/black"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="0dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintDimensionRatio="4:3"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <com.jiangdg.ausbc.widget.AspectRatioTextureView
                            android:id="@+id/tvCameraRender"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_gravity="center" />
                    </androidx.cardview.widget.CardView>

                    <TextView
                        android:id="@+id/tv_status_ok"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:background="@drawable/bg_status_badge"
                        android:backgroundTint="@color/success_green"
                        android:elevation="4dp"
                        android:paddingHorizontal="24dp"
                        android:paddingVertical="8dp"
                        android:text="OK"
                        android:textColor="@color/white"
                        android:textSize="32sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:text="SUCCESS" />


                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>
        </LinearLayout>


        <!-- Middle Section: 4 Equal Columns -->
        <LinearLayout
            android:id="@+id/ll_middle"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:baselineAligned="false"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ll_top">

            <!-- Column 1: Product Info -->
            <LinearLayout
                android:id="@+id/card_product_info"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Product Details"
                        android:textColor="@color/text_primary"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginBottom="8dp"
                        android:background="@color/border_color" />

                    <!-- Info Rows -->
                    <LinearLayout style="@style/InfoRow">

                        <TextView
                            style="@style/InfoLabel"
                            android:text="Country:" />

                        <TextView
                            android:id="@+id/tv_country"
                            style="@style/InfoValue"
                            android:text="GERMANY" />
                    </LinearLayout>


                    <LinearLayout style="@style/InfoRow">

                        <TextView
                            style="@style/InfoLabel"
                            android:text="Total Order:" />

                        <TextView
                            android:id="@+id/tv_total_order"
                            style="@style/InfoValue"
                            android:text="300" />
                    </LinearLayout>

                    <LinearLayout style="@style/InfoRow">

                        <TextView
                            style="@style/InfoLabel"
                            android:text="Completed:" />

                        <TextView
                            android:id="@+id/tv_completed"
                            style="@style/InfoValue"
                            android:text="0" />
                    </LinearLayout>

                    <LinearLayout style="@style/InfoRow">

                        <TextView
                            style="@style/InfoLabel"
                            android:text="Remaining:" />

                        <TextView
                            android:id="@+id/tv_remaining"
                            style="@style/InfoValue"
                            android:text="300"
                            android:textColor="@color/error_red" />
                    </LinearLayout>

                    <LinearLayout style="@style/InfoRow">

                        <TextView
                            style="@style/InfoLabel"
                            android:text="Lean:" />

                        <TextView
                            android:id="@+id/tv_lean"
                            style="@style/InfoValue"
                            android:text="A1_G01" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Column 2: Product Image -->
            <LinearLayout
                android:id="@+id/card_product_image"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="Product Image"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp">

                    <ImageView
                        android:id="@+id/iv_shoe_image"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerInside"
                        android:src="@android:drawable/ic_menu_report_image"
                        tools:srcCompat="@drawable/shoe_placeholder" />
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- Column 3: Stats -->
            <LinearLayout
                android:id="@+id/card_stats"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Box Size Label"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginBottom="8dp"
                    android:background="@color/border_color" />

                <LinearLayout style="@style/InfoRow">

                    <TextView
                        style="@style/InfoLabel"
                        android:text="RY:" />

                    <TextView
                        android:id="@+id/tv_ry_value"
                        style="@style/InfoValue"
                        android:text="AH2412-751" />
                </LinearLayout>

                <LinearLayout style="@style/InfoRow">

                    <TextView
                        style="@style/InfoLabel"
                        android:text="Article:" />

                    <TextView
                        android:id="@+id/tv_art"
                        style="@style/InfoValue"
                        android:text="JH9767" />
                </LinearLayout>


                <LinearLayout style="@style/InfoRow">

                    <TextView
                        style="@style/InfoLabel"
                        android:text="Size:" />

                    <TextView
                        android:id="@+id/tv_size_value"
                        style="@style/InfoValue"
                        android:text="08" />
                </LinearLayout>


                <LinearLayout style="@style/InfoRow">

                    <TextView
                        style="@style/InfoLabel"
                        android:text="PO No:" />

                    <TextView
                        android:id="@+id/tv_po_value"
                        style="@style/InfoValue"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="0900005032" />
                </LinearLayout>

                <LinearLayout style="@style/InfoRow">

                    <TextView
                        style="@style/InfoLabel"
                        android:text="UPC:" />

                    <TextView
                        android:id="@+id/tv_upc_value"
                        style="@style/InfoValue"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="4067898529187" />
                </LinearLayout>

                <LinearLayout style="@style/InfoRow">

                    <TextView
                        style="@style/InfoLabel"
                        android:text="Qty:" />

                    <TextView
                        android:id="@+id/tv_qty_value"
                        style="@style/InfoValue"
                        android:text="12"
                        android:textSize="24dp"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_scan_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Last Scan: --"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <ProgressBar
                    android:id="@+id/pbMotion"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Column 4: RFID Display Area -->
            <LinearLayout
                android:id="@+id/card_rfid"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_card"
                android:orientation="vertical">

                <!-- Header with Settings Icon -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="3dp"
                    android:paddingBottom="8dp">

                    <ImageView
                        android:id="@+id/iv_rfid_icon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="8dp"
                        android:src="@drawable/ic_rfid_card"
                        app:tint="@color/primary_blue" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="RFID Hangtag"
                        android:textColor="@color/text_primary"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <!-- Settings Icon Button -->
                    <ImageView
                        android:id="@+id/btn_usb_rfid"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:padding="3dp"
                        android:src="@android:drawable/ic_menu_manage"
                        app:tint="@color/primary_blue" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/border_color" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="2dp">

                    <!-- Product Information from API -->
                    <LinearLayout
                        android:id="@+id/ll_rfid_product_info"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <LinearLayout style="@style/InfoRow">

                            <TextView
                                style="@style/InfoLabel"
                                android:text="Model:" />

                            <TextView
                                android:id="@+id/tv_rfid_model"
                                style="@style/InfoValue"
                                android:text="---" />
                        </LinearLayout>

                        <LinearLayout style="@style/InfoRow">

                            <TextView
                                style="@style/InfoLabel"
                                android:text="Article:" />

                            <TextView
                                android:id="@+id/tv_rfid_article"
                                style="@style/InfoValue"
                                android:text="---" />
                        </LinearLayout>

                        <LinearLayout style="@style/InfoRow">

                            <TextView
                                style="@style/InfoLabel"
                                android:text="Size:" />

                            <TextView
                                android:id="@+id/tv_rfid_size"
                                style="@style/InfoValue"
                                android:text="---" />
                        </LinearLayout>

                        <LinearLayout style="@style/InfoRow">

                            <TextView
                                style="@style/InfoLabel"
                                android:text="PO No:" />

                            <TextView
                                android:id="@+id/tv_rfid_po"
                                style="@style/InfoValue"
                                android:text="---" />
                        </LinearLayout>

                        <LinearLayout style="@style/InfoRow">

                            <TextView
                                style="@style/InfoLabel"
                                android:text="UPC:" />

                            <TextView
                                android:id="@+id/tv_rfid_upc"
                                style="@style/InfoValue"
                                android:text="---" />
                        </LinearLayout>


                        <!-- Connection Status -->
                        <TextView
                            android:id="@+id/tv_rfid_status"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="6dp"
                            android:text="• Not Connected"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />

                    </LinearLayout>

                    <!-- Last EPC -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:id="@+id/tv_epc_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="EPC CODE"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/tv_dashboard_last_rfid"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="monospace"
                            android:text="---"
                            android:textColor="@color/primary_blue"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            app:layout_constraintBottom_toBottomOf="@id/tv_epc_label"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@id/tv_epc_label"
                            app:layout_constraintTop_toTopOf="@id/tv_epc_label" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
