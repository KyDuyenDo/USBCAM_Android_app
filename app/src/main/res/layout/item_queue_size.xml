<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Size Label -->
    <TextView
        android:id="@+id/tv_size_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="05.5"
        android:textColor="@color/primary_blue"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_color"
        android:layout_marginBottom="8dp"/>

    <!-- Info Rows -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="4dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="TỔNG" android:textColor="#888888" android:textSize="12sp"/>
        <TextView android:id="@+id/tv_total" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1" android:textColor="#888888" android:textSize="14sp" android:textStyle="bold"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="4dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Hoàn Thành" android:textColor="#888888" android:textSize="12sp"/>
        <TextView android:id="@+id/tv_completed" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/success_green" android:textSize="14sp" android:textStyle="bold"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="4dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Còn Lại" android:textColor="#888888" android:textSize="12sp"/>
        <TextView android:id="@+id/tv_remaining" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1" android:textColor="#FF8C00" android:textSize="14sp" android:textStyle="bold"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Hôm nay" android:textColor="#888888" android:textSize="12sp"/>
        <TextView android:id="@+id/tv_today" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/primary_blue" android:textSize="14sp" android:textStyle="bold"/>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_color"
        android:layout_marginBottom="12dp"/>

    <!-- Input Box -->
    <TextView
        android:id="@+id/tv_input_qty"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:minWidth="64dp"
        android:layout_gravity="center"
        android:gravity="center"
        android:text="0"
        android:textColor="#1E1E1E"
        android:textSize="30sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/btn_minus_10"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:backgroundTint="#ED584E"
            android:textColor="#FFFFFF"
            android:text="-10"
            android:textSize="20sp"
            android:padding="0dp"/>

        <Button
            android:id="@+id/btn_minus_1"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:backgroundTint="#ED584E"
            android:textColor="#FFFFFF"
            android:text="-1"
            android:textSize="20sp"
            android:padding="0dp"/>

        <Button
            android:id="@+id/btn_plus_1"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:backgroundTint="#5AE881"
            android:textColor="#FFFFFF"
            android:text="+1"
            android:textSize="20sp"
            android:padding="0dp"/>

        <Button
            android:id="@+id/btn_plus_10"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:backgroundTint="#5AE881"
            android:textColor="#FFFFFF"
            android:text="+10"
            android:textSize="20sp"
            android:padding="0dp"/>
    </LinearLayout>

</LinearLayout>
