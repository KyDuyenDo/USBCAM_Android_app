<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:background="@drawable/bg_card"
    android:orientation="horizontal"
    android:padding="0dp">

    <!-- Left side (Info) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Title Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tv_item_zlbh"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="AH2512-073"
                android:textColor="@color/primary_blue"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_item_qty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="QTY: 0"
                android:textColor="@color/success_green"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border_color"
            android:layout_marginBottom="12dp"/>

        <!-- Info Grid -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Col 1 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView android:id="@+id/tv_item_po" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#BBBBBB" android:textSize="14sp" android:text="PO: 0901088551" android:layout_marginBottom="4dp"/>
                <TextView android:id="@+id/tv_item_article" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#BBBBBB" android:textSize="14sp" android:text="Article: JR1231" android:layout_marginBottom="4dp"/>
                <TextView android:id="@+id/tv_item_country" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#BBBBBB" android:textSize="14sp" android:text="Country: UNITED STATES"/>
            </LinearLayout>

            <!-- Col 2 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView android:id="@+id/tv_item_lean" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#BBBBBB" android:textSize="14sp" android:text="Lean: C_G07" android:layout_marginBottom="4dp"/>
                <TextView android:id="@+id/tv_item_start" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#BBBBBB" android:textSize="14sp" android:text="Start: 2025-12-12" android:layout_marginBottom="4dp"/>
                <TextView android:id="@+id/tv_item_end" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#BBBBBB" android:textSize="14sp" android:text="End: 2026-04-02"/>
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/btn_add_queue"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:text="➕ THÊM VÀO HÀNG CHỜ"
            android:textColor="@color/white"
            android:backgroundTint="#FF8C00"
            android:textStyle="bold"
            app:cornerRadius="8dp" />

    </LinearLayout>

    <!-- Right side (Image) -->
    <androidx.cardview.widget.CardView
        android:layout_width="200dp"
        android:layout_height="match_parent"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        android:layout_margin="8dp">

        <ImageView
            android:id="@+id/iv_item_shoe"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:background="#E0E0E0" />
    </androidx.cardview.widget.CardView>

</LinearLayout>
