<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="#FFFFFF">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="RFID Configuration"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#1A1C1E"/>

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@android:drawable/ic_menu_manage"
                app:tint="#4285F4"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#F0F0F0"
            android:layout_marginBottom="24dp"/>

        <!-- Connection Status Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_status_badge"
            android:backgroundTint="#F8F9FA"
            android:padding="16dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CONNECTION STATUS"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#5F6368"
                android:letterSpacing="0.1"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tv_connection_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="❌ Disconnected"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#D93025"/>
        </LinearLayout>

        <!-- Current Device Info -->
        <TextView
            android:id="@+id/tv_device_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PID: 0x5752 | VID: 0x0479"
            android:textSize="13sp"
            android:textColor="#1E8E3E"
            android:padding="12dp"
            android:background="#E6F4EA"
            android:visibility="gone"
            android:layout_marginBottom="20dp"
            android:gravity="center"/>

        <!-- Device Selection -->
        <LinearLayout
            android:id="@+id/ll_device_selection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select USB Reader"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#3C4043"
                android:layout_marginBottom="12dp"/>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_status_badge"
                android:backgroundTint="#F1F3F4">
                <Spinner
                    android:id="@+id/spinner_usb_devices"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:overlapAnchor="false"/>
            </FrameLayout>
        </LinearLayout>

        <!-- Action Buttons Grid -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_connect"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="Connect"
                android:layout_marginEnd="8dp"
                app:cornerRadius="12dp"
                android:backgroundTint="#1E8E3E"
                android:insetTop="0dp"
                android:insetBottom="0dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_disconnect"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="Disconnect"
                android:enabled="false"
                app:cornerRadius="12dp"
                android:backgroundTint="#D93025"
                android:insetTop="0dp"
                android:insetBottom="0dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_refresh_devices"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="Refresh"
                android:layout_marginEnd="8dp"
                app:cornerRadius="12dp"
                android:textColor="#1967D2"
                app:strokeColor="#1967D2"
                android:insetTop="0dp"
                android:insetBottom="0dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_close_settings"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="Close"
                app:cornerRadius="12dp"
                android:textColor="#5F6368"
                android:insetTop="0dp"
                android:insetBottom="0dp"/>
        </LinearLayout>

        <!-- Footer Info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:background="#FFF9C4"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⭐ Star indicates the default device. System will auto-connect on startup. Manual selection is only for troubleshooting."
                android:textSize="11sp"
                android:textColor="#5F6368"
                android:lineSpacingExtra="2dp"/>
        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
